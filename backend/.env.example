GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ASHIEY_TOKEN_SECRET=replace-with-a-long-random-secret

# Regular CS chat uses Groq when configured; PDFs continue to use Gemini.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# One fallback for a quick 503 before any answer; blank disables it.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
